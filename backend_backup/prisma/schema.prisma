generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  rcc
  engineer
  staff
}

enum PlotStatus {
  available
  reserved
  occupied
  full
}

enum LotType {
  single
  family
  apartment
}

enum ContractType {
  new
  renewal
}

enum PaymentType {
  cash
  installment
}

enum ContractStatus {
  active
  completed
  cancelled
}

enum InquiryStatus {
  pending
  approved
  rejected
  completed
}

enum BurialStatus {
  scheduled
  completed
  cancelled
}

enum PaymentMethod {
  cash
  installment
}

enum NotificationType {
  renewal
  approval
  rejection
}

enum NotificationChannel {
  email
  sms
  in_app
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(255)
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  contractsPrepared  Contract[]      @relation("prepared_by")
  inquiriesProcessed Inquiry[]
  burialsScheduled   Burial[]        @relation("scheduled_by")
  paymentsCollected  Payment[]       @relation("collected_by")
  mapsCreated        CemeteryMap[]
  notifications      Notification[]
  activityLogs       ActivityLog[]

  @@map("users")
}

model Client {
  id            String   @id @default(uuid()) @db.Uuid
  fullName      String   @map("full_name") @db.VarChar(255)
  contactNumber String   @map("contact_number") @db.VarChar(50)
  email         String?  @db.VarChar(255)
  address       String?  @db.Text
  idNumber      String?  @map("id_number") @db.VarChar(100)
  idType        String?  @map("id_type") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  contracts Contract[]
  inquiries Inquiry[]

  @@map("clients")
}

model Plot {
  id                String     @id @default(uuid()) @db.Uuid
  plotNumber        String     @unique @map("plot_number") @db.VarChar(50)
  section           String     @db.VarChar(100)
  lat               Float?
  lng               Float?
  lotType           LotType    @map("lot_type")
  capacity          Int        @default(1)
  currentOccupants  Int        @default(0) @map("current_occupants")
  status            PlotStatus @default(available)
  price             Decimal?   @db.Decimal(10, 2)
  nearestPathNodeId String?    @map("nearest_path_node_id") @db.Uuid
  notes             String?    @db.Text
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  contracts Contract[]
  inquiries Inquiry[]
  burials   Burial[]

  @@map("plots")
}

model PathNode {
  id          String   @id @default(uuid()) @db.Uuid
  lat         Float
  lng         Float
  nodeLabel   String?  @map("node_label") @db.VarChar(100)
  isAccessible Boolean @default(true) @map("is_accessible")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  edgesFrom PathEdge[] @relation("from_node")
  edgesTo   PathEdge[] @relation("to_node")

  @@map("path_nodes")
}

model PathEdge {
  id            String   @id @default(uuid()) @db.Uuid
  fromNodeId    String   @map("from_node_id") @db.Uuid
  toNodeId      String   @map("to_node_id") @db.Uuid
  distanceWeight Decimal @map("distance_weight") @db.Decimal(10, 2)
  pathwayName   String?  @map("pathway_name") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  fromNode PathNode @relation("from_node", fields: [fromNodeId], references: [id])
  toNode   PathNode @relation("to_node", fields: [toNodeId], references: [id])

  @@map("path_edges")
}

model Contract {
  id                       String         @id @default(uuid()) @db.Uuid
  clientId                 String         @map("client_id") @db.Uuid
  plotId                   String         @map("plot_id") @db.Uuid
  contractDate             DateTime       @map("contract_date") @db.Date
  contractType             ContractType   @map("contract_type")
  commencementDate         DateTime?      @map("commencement_date") @db.Date
  expirationDate           DateTime?      @map("expiration_date") @db.Date
  totalAmount              Decimal        @map("total_amount") @db.Decimal(12, 2)
  paymentType              PaymentType    @map("payment_type")
  status                   ContractStatus @default(active)
  preparedById             String?        @map("prepared_by") @db.Uuid
  approvedBySuperadminAt   DateTime?      @map("approved_by_superadmin_at")
  deathCertificateNumber   String?        @map("death_certificate_number") @db.VarChar(100)
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")

  client    Client  @relation(fields: [clientId], references: [id])
  plot      Plot    @relation(fields: [plotId], references: [id])
  preparedBy User?  @relation("prepared_by", fields: [preparedById], references: [id])
  burials   Burial[]
  payments  Payment[]

  @@map("contracts")
}

model Inquiry {
  id            String         @id @default(uuid()) @db.Uuid
  clientId      String         @map("client_id") @db.Uuid
  plotId        String?        @map("plot_id") @db.Uuid
  inquiryDate   DateTime       @map("inquiry_date") @db.Date
  message       String?        @db.Text
  status        InquiryStatus  @default(pending)
  processedById String?        @map("processed_by") @db.Uuid
  processedAt   DateTime?      @map("processed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  client      Client @relation(fields: [clientId], references: [id])
  plot        Plot?  @relation(fields: [plotId], references: [id])
  processedBy User?  @relation(fields: [processedById], references: [id])

  @@map("inquiries")
}

model Burial {
  id            String       @id @default(uuid()) @db.Uuid
  plotId        String       @map("plot_id") @db.Uuid
  contractId    String       @map("contract_id") @db.Uuid
  deceasedName  String       @map("deceased_name") @db.VarChar(255)
  dateOfBirth   DateTime?    @map("date_of_birth") @db.Date
  dateOfDeath   DateTime     @map("date_of_death") @db.Date
  burialDate    DateTime     @map("burial_date")
  burialStatus  BurialStatus @default(scheduled) @map("burial_status")
  scheduledById String?      @map("scheduled_by") @db.Uuid
  approvedAt    DateTime?    @map("approved_at")
  notes         String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  plot         Plot  @relation(fields: [plotId], references: [id])
  contract     Contract @relation(fields: [contractId], references: [id])
  scheduledBy  User?    @relation("scheduled_by", fields: [scheduledById], references: [id])

  @@map("burials")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  contractId     String        @map("contract_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  paymentDate    DateTime      @map("payment_date") @db.Date
  paymentMethod  PaymentMethod @map("payment_method")
  receiptNumber  String?       @map("receipt_number") @db.VarChar(100)
  collectedById  String?       @map("collected_by") @db.Uuid
  notes          String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  contract     Contract @relation(fields: [contractId], references: [id])
  collectedBy  User?    @relation("collected_by", fields: [collectedById], references: [id])

  @@map("payments")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  type      NotificationType
  channel   NotificationChannel
  subject   String             @db.VarChar(255)
  message   String             @db.Text
  isRead    Boolean            @default(false) @map("is_read")
  sentAt    DateTime?          @map("sent_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ActivityLog {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  action      String    @db.VarChar(100)
  module      String    @db.VarChar(100)
  description String    @db.Text
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

model CemeteryMap {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  boundaryData Json?    @map("boundary_data") @db.JsonB
  createdById  String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdBy User? @relation(fields: [createdById], references: [id])

  @@map("cemetery_maps")
}

model LotTypeCategory {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(100)
  description     String?  @db.Text
  defaultCapacity Int      @map("default_capacity")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("lot_type_categories")
}